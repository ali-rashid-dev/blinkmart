
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean
  image         String?
  role          Role           @default(USER)
  banned        Boolean        @default(false)
  banReason     String?
  bannedAt      DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  cart          Cart?
  orders        Order[]
  notifications Notification[]

  @@map("user")
}

model UserProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String?
  houseNo    String?
  street     String?
  area       String?
  city       String?
  postalCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_profile")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@index([identifier])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.Citext
  slug      String   @unique @db.Citext
  imageUrl  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@map("category")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique @db.Citext
  origin    String?
  enabled   Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brand")
  @@index([enabled])
}

model Product {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique @db.Citext
  description String?
  price       Decimal    @db.Decimal(10, 2)
  imageUrl    String?
  enabled     Boolean    @default(true)
  brandId     String?
  brand       Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("product")
  @@index([brandId])
  @@index([categoryId])
  @@index([enabled])
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]

  @@map("cart")
  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_item")
  @@index([cartId])
  @@index([productId])
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status       OrderStatus @default(PLACED)
  subtotal     Decimal     @db.Decimal(10, 2)
  deliveryFee  Decimal     @db.Decimal(10, 2) @default(0.00)
  platformFee  Decimal     @db.Decimal(10, 2) @default(20.00)
  total        Decimal     @db.Decimal(10, 2)
  deliveryDate DateTime
  deliverySlot String      @default("7:00 PM – 10:00 PM")
  cancelReason String?
  cancelledAt  DateTime?

  // Delivery Address Snapshot
  fullName     String
  phone        String
  house        String
  street       String
  area         String
  city         String
  postal       String
  notes        String?

  items         OrderItem[]
  notifications Notification[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("order")
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  unit      String   @default("1 pack")
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_item")
  @@index([orderId])
  @@index([productId])
}

enum NotificationKind {
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PROMOTION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notification")
  @@index([userId, createdAt(sort: Desc)])
  @@index([orderId])
}
